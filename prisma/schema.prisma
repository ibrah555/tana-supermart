datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @default("")
  passwordHash String?  @default("")
  role         String   @default("CUSTOMER") // SUPER_ADMIN, OPERATIONS, FINANCE, VENDOR, CUSTOMER
  status       String   @default("Active")   // Active, Flagged, Suspended
  totalSpent   Float    @default(0)
  ordersCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
  stores Store[]
}

model Store {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  rating           Float    @default(4.8)
  positiveFeedback Int      @default(98)
  isVerified       Boolean  @default(true)
  status           String   @default("Active") // Active, Pending KYC, Suspended
  commissionRate   Float    @default(8.0)
  contactEmail     String?  @default("")
  phone            String?  @default("")
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  createdAt        DateTime @default(now())
}

model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  icon         String   @default("")
  image        String   @default("")
  productCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model Product {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  price             Float
  originalPrice     Float?
  costPrice         Float     @default(0)
  stockQuantity     Int       @default(50)
  lowStockThreshold Int       @default(10)
  inStock           Boolean   @default(true)
  rating            Float     @default(4.7)
  reviewsCount      Int       @default(0)
  soldCount         Int       @default(0)
  isFlashSale       Boolean   @default(false)
  flashSaleEndsAt   DateTime?
  isApproved        Boolean   @default(true)
  categorySlug      String
  subCategorySlug   String?
  storeId           String
  images            String[]
  tags              String[]
  shortDescription  String    @default("")
  fullDescription   String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  orderItems OrderItem[]
}

model Order {
  id                String   @id @default(cuid())
  orderNumber       String   @unique
  userId            String?
  user              User?    @relation(fields: [userId], references: [id])
  customerName      String
  customerEmail     String
  customerPhone     String
  status            String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, PROCESSING, SHIPPED, DELIVERED, CANCELLED
  subtotal          Float
  deliveryFee       Float
  discount          Float    @default(0)
  total             Float
  cogs              Float    @default(0)
  profit            Float    @default(0)
  county            String
  addressLine       String
  paymentMethod     String   @default("MPESA") // MPESA, CARD, CASH_ON_DELIVERY
  mpesaReceipt      String?
  trackingNumber    String?
  estimatedDelivery String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items        OrderItem[]
  transactions MpesaTransaction[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  title     String
  price     Float
  costPrice Float    @default(0)
  quantity  Int
  image     String
}

model MpesaTransaction {
  id                 String   @id @default(cuid())
  orderId            String?
  order              Order?   @relation(fields: [orderId], references: [id])
  checkoutRequestId  String   @unique
  merchantRequestId  String
  mpesaReceiptNumber String?
  phoneNumber        String
  amount             Float
  status             String   @default("PENDING") // PENDING, COMPLETED, FAILED
  resultDesc         String?
  rawCallbackData    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CountyShippingRate {
  id            String  @id @default(cuid())
  countyName    String  @unique
  capitalTown   String
  region        String
  standardFee   Float
  expressFee    Float
  estimatedDays String
  isActive      Boolean @default(true)
}

model CategoryCommission {
  id           String @id @default(cuid())
  categorySlug String @unique
  categoryName String
  ratePercent  Float
  minimumFee   Float
}

model Voucher {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String   @default("FIXED") // FIXED, PERCENTAGE
  discountValue Float
  minSpend      Float    @default(0)
  maxDiscount   Float?
  expiresAt     DateTime
  usageLimit    Int      @default(100)
  usedCount     Int      @default(0)
  isActive      Boolean  @default(true)
}
